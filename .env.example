# Local Docker Compose defaults only. Never reuse these values in production.
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse-local-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=pulse-local
MINIO_ROOT_PASSWORD=pulse-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

PULSE_PORT=8000
PULSE_ENVIRONMENT=development
PULSE_SECRET_KEY=development-only-change-this-secret-key
PULSE_BOOTSTRAP_TOKEN=development-bootstrap-token-change-this
PULSE_COOKIE_SECURE=false
PULSE_SESSION_TTL_HOURS=168
# Bulk CRM export is not implemented in the MVP and remains denied by default.
PULSE_CRM_EXPORT_ENABLED=false
# Limits rapid sequential traversal of cursor-paginated CRM lists per user/resource.
PULSE_CURSOR_PAGE_BUDGET=20
PULSE_CURSOR_PAGE_WINDOW_SECONDS=900
PULSE_JOB_RUNNER_ENABLED=true
PULSE_JOB_RUNNER_POLL_SECONDS=1
PULSE_JOB_RUNNER_HEARTBEAT_TIMEOUT_SECONDS=30
PULSE_ALLOWED_HOSTS='["localhost","127.0.0.1"]'
PULSE_STATIC_DIR=/app/backend/static
PULSE_RUN_MIGRATIONS=true
PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse-local-password@localhost:5432/pulse
# Base64 for exactly 16/24/32 random bytes. Generate for production with:
# openssl rand -base64 32
PULSE_INTEGRATION_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS0zMi1ieXRlLWtleSEhISE=
PULSE_INTEGRATION_ENCRYPTION_KEY_ID=primary

# Optional PWA Web Push. Generate one stable P-256 pair with
# python scripts/generate_vapid_keys.py --subject mailto:admin@example.com
# and set all three variables together. Keep the private key secret.
# PULSE_WEB_PUSH_VAPID_PUBLIC_KEY=BASE64URL_PUBLIC_KEY
# PULSE_WEB_PUSH_VAPID_PRIVATE_KEY=BASE64URL_PRIVATE_KEY
# PULSE_WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# S3-compatible storage. Compose points the app to the MinIO service.
PULSE_S3_REGION=ru-1
PULSE_S3_BUCKET=pulse-local
PULSE_S3_ACCESS_KEY_ID=pulse-local
PULSE_S3_SECRET_ACCESS_KEY=pulse-local-minio-password
PULSE_S3_ENDPOINT_URL=http://localhost:9000

# Development SMTP capture (Mailpit).
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
